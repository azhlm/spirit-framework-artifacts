rule APT_X64_Lea_Call_Strings_Noise_Pattern
{
    meta:
        description = "Detects repeated x64 LEA + SetLastError pattern"
        author = "Minh Anh"
        architecture = "x64"

    strings:
        /* Instruction pattern:
           lea rcx, [rip+imm32]
           call qword ptr [rip+imm32] ; SetLastError
        */
        $lea_call = {48 83 EC 28 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? }

    condition:
        uint16(0) == 0x5a4d and
        #lea_call
}
